---
import {
  useTranslations,
  type Lang,
  defaultLang,
  getLocalizedPath,
  getPathWithoutLang,
  languages,
} from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const homePath = getLocalizedPath('', lang, base);

// Anchors only exist on the homepage — link back there with the anchor so
// they still work from other pages (e.g. About).
const navItems = [
  { href: `${homePath}#funkcije`, label: t('nav.features') },
  { href: `${homePath}#privatnost`, label: t('nav.privacy') },
  { href: getLocalizedPath('about', lang, base), label: t('nav.about') },
  { href: `${homePath}#kontakt`, label: t('nav.contact') },
];

// Preserve the current page (home vs about) when switching language.
const currentPath = getPathWithoutLang(Astro.url.pathname.replace(base, '/'));
---

<header class="fixed top-0 inset-x-0 z-50 bg-primary/80 backdrop-blur border-b border-secondary">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
    <a href={homePath} class="flex items-center gap-2 text-lg font-semibold tracking-tight text-text shrink-0">
      <img src={`${base}app-icon.png`} alt="" width="28" height="28" class="rounded-lg" />
      {t('site.title')}
    </a>
    <nav class="hidden sm:flex gap-6 text-sm text-text-muted">
      {navItems.map((item) => (
        <a href={item.href} class="hover:text-text transition-colors">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <!-- Mobile nav — the <nav> above is hidden below sm with no other way
           to reach it, so this hamburger is the only path to Features/About/
           etc. on a phone. -->
      <details class="relative sm:hidden">
        <summary
          class="list-none cursor-pointer p-2 rounded-lg bg-secondary text-text-muted hover:text-text transition-colors [&::-webkit-details-marker]:hidden"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <path d="M4 6h16 M4 12h16 M4 18h16" />
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 min-w-[10rem] rounded-lg bg-secondary border border-primary shadow-lg overflow-hidden z-10">
          {navItems.map((item) => (
            <a href={item.href} class="block px-4 py-2.5 text-sm text-text-muted hover:text-text hover:bg-primary/30 transition-colors">
              {item.label}
            </a>
          ))}
        </div>
      </details>

      <details class="relative">
        <summary
          class="list-none cursor-pointer flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-secondary text-sm text-text-muted hover:text-text transition-colors [&::-webkit-details-marker]:hidden"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M3 12h18 M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9Z" />
          </svg>
          <span class="hidden sm:inline">{languages[lang]}</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 min-w-[11rem] rounded-lg bg-secondary border border-primary shadow-lg overflow-hidden z-10">
          {Object.keys(languages).map((code) => (
            <a
              href={getLocalizedPath(currentPath, code as Lang, base)}
              class={`block px-4 py-2.5 text-sm transition-colors ${
                lang === code
                  ? 'text-accent-light font-medium bg-primary/40'
                  : 'text-text-muted hover:text-text hover:bg-primary/30'
              }`}
            >
              {languages[code as Lang]}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
