---
import { useTranslations, type Lang, defaultLang, getLocalizedPath, languages } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const navItems = [
  { href: '#funkcije', label: t('nav.features') },
  { href: '#privatnost', label: t('nav.privacy') },
  { href: '#kontakt', label: t('nav.contact') },
];
---

<header class="fixed top-0 inset-x-0 z-50 bg-primary/80 backdrop-blur border-b border-secondary">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
    <a href={getLocalizedPath('', lang, base)} class="text-lg font-semibold tracking-tight text-text shrink-0">
      {t('hero.title1')}<span class="accent-gradient">{t('hero.title2')}</span>
    </a>
    <nav class="hidden sm:flex gap-6 text-sm text-text-muted">
      {navItems.map((item) => (
        <a href={item.href} class="hover:text-text transition-colors">{item.label}</a>
      ))}
    </nav>
    <div class="flex gap-1 text-xs">
      {Object.keys(languages).map((code) => (
        <a
          href={getLocalizedPath('', code as Lang, base)}
          class={`px-2 py-1 rounded transition-colors font-medium ${
            lang === code ? 'bg-secondary text-accent-light' : 'text-text-muted hover:text-text'
          }`}
        >
          {code === 'sr' ? 'ćir' : code === 'sr-Latn' ? 'lat' : code}
        </a>
      ))}
    </div>
  </div>
</header>
