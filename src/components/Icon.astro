---
// Small hand-rolled icon set so the feature list doesn't need an icon
// library dependency for a dozen glyphs.
interface Props {
  name:
    | 'scan'
    | 'receipt'
    | 'layers'
    | 'card'
    | 'repeat'
    | 'users'
    | 'shield'
    | 'bell'
    | 'clock'
    | 'piggybank'
    | 'tag'
    | 'chart';
  class?: string;
}

const { name, class: className = 'w-6 h-6' } = Astro.props;

const paths: Record<Props['name'], string> = {
  scan: 'M4 8V5a1 1 0 0 1 1-1h3 M20 8V5a1 1 0 0 0-1-1h-3 M4 16v3a1 1 0 0 0 1 1h3 M20 16v3a1 1 0 0 1-1 1h-3 M7 12h10',
  receipt:
    'M6 3h12v18l-2.5-1.5L13 21l-2.5-1.5L8 21l-2-1.5V3Z M9 8h6 M9 12h6 M9 16h4',
  layers: 'M12 3 3 8l9 5 9-5-9-5Z M3 13l9 5 9-5 M3 8v5 M21 8v5',
  card: 'M3 6h18a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z M2 10h20 M6 14h4',
  repeat: 'M4 7h13l-3-3 M20 17H7l3 3 M4 7v4a2 2 0 0 0 2 2h2 M20 17v-4a2 2 0 0 0-2-2h-2',
  users:
    'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M3 20c0-3.3 2.7-5 6-5s6 1.7 6 5 M17 11a3 3 0 1 0 0-6 M21 20c0-2.6-1.8-4.3-4-4.8',
  shield: 'M12 3 4 6v6c0 5 3.4 7.7 8 9 4.6-1.3 8-4 8-9V6l-8-3Z M9 12l2 2 4-4',
  bell: 'M6 9a6 6 0 1 1 12 0c0 5 2 6 2 6H4s2-1 2-6Z M10 20a2 2 0 0 0 4 0',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M12 7v5l4 2',
  piggybank:
    'M4 12a5 5 0 0 1 5-5h3.5a5 5 0 0 1 4.5 3l2 .5v3l-2 .5a5 5 0 0 1-1 2l.5 2h-3l-.5-1.5H8.5L8 19H5l.5-2A5 5 0 0 1 4 13Z M8 10.5V9 M2 13h2',
  tag: 'M20 12 12.5 19.5a2 2 0 0 1-2.8 0L4 13.8V4h9.8L20 10.2a2 2 0 0 1 0 2.8Z M9 8.5h.01',
  chart: 'M4 20V10 M10 20V4 M16 20v-7 M3 20h18',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <path d={paths[name]} />
</svg>
