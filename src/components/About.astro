---
import { useTranslations, type Lang, defaultLang } from '../i18n/utils';

interface Props {
  lang?: Lang;
  linkedinUrl?: string;
}

const { lang = defaultLang, linkedinUrl = '#' } = Astro.props;
const t = useTranslations(lang);
---

<section class="pt-40 pb-24 px-6">
  <div class="max-w-xl mx-auto text-center">
    <h1 class="text-3xl font-bold mb-10">{t('about.heading')}</h1>

    <!--
      TODO: replace with a real photo once available — drop the file in
      public/ (e.g. public/nikola.jpg) and swap this placeholder for
      <img src={`${import.meta.env.BASE_URL}nikola.jpg`} alt={t('about.name')} class="..." />
    -->
    <div class="w-32 h-32 mx-auto mb-6 rounded-full bg-secondary border border-accent/30 flex items-center justify-center text-4xl font-bold text-accent-light">
      {t('about.name').charAt(0)}
    </div>

    <p class="font-semibold text-lg mb-4">{t('about.name')}</p>
    <p class="text-text-muted leading-relaxed mb-8">{t('about.bio')}</p>

    <a
      href={linkedinUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-secondary hover:bg-secondary/70 transition-colors text-accent-light font-medium"
    >
      {t('about.linkedin')}
    </a>
  </div>
</section>
