---
import { useTranslations, type Lang, defaultLang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const widgetSteps = [
  { icon: 'widget' as const, text: t('howItWorks.widget.step1') },
  { icon: 'scan' as const, text: t('howItWorks.widget.step2') },
  { icon: 'receipt' as const, text: t('howItWorks.widget.step3') },
];

const appSteps = [
  { icon: 'devices' as const, text: t('howItWorks.app.step1') },
  { icon: 'scan' as const, text: t('howItWorks.app.step2') },
  { icon: 'receipt' as const, text: t('howItWorks.app.step3') },
  { icon: 'sliders' as const, text: t('howItWorks.app.step4') },
];
---

<section class="py-24 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold mb-3">{t('howItWorks.heading')}</h2>
      <p class="text-text-muted">{t('howItWorks.subheading')}</p>
      <div class="section-divider mt-6"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-xl bg-secondary/40 border border-border">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-accent mb-5">
          {t('howItWorks.widget.label')}
        </h3>
        <ol class="space-y-4">
          {widgetSteps.map((step, i) => (
            <li class="flex gap-4 items-start">
              <div class="shrink-0 w-9 h-9 rounded-lg bg-primary border border-border flex items-center justify-center text-accent">
                <Icon name={step.icon} class="w-4 h-4" />
              </div>
              <p class="text-sm text-text-muted leading-relaxed pt-1.5">
                <span class="text-text font-medium">{i + 1}.</span> {step.text}
              </p>
            </li>
          ))}
        </ol>
      </div>

      <div class="p-6 rounded-xl bg-primary border border-border">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-accent mb-5">
          {t('howItWorks.app.label')}
        </h3>
        <ol class="space-y-4">
          {appSteps.map((step, i) => (
            <li class="flex gap-4 items-start">
              <div class="shrink-0 w-9 h-9 rounded-lg bg-secondary flex items-center justify-center text-accent">
                <Icon name={step.icon} class="w-4 h-4" />
              </div>
              <p class="text-sm text-text-muted leading-relaxed pt-1.5">
                <span class="text-text font-medium">{i + 1}.</span> {step.text}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
