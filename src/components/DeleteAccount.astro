---
import { useTranslations, type Lang, defaultLang } from '../i18n/utils';
import { API_BASE_URL } from '../site-config';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

// Passed into the client script below via define:vars — everything the
// script needs to render text has to come from here, since the backend's
// own error messages are English-only and this page is multilingual.
const i18n = {
  sending: t('deleteAccount.sending'),
  deleting: t('deleteAccount.deleting'),
  confirmPrompt: t('deleteAccount.confirmPrompt'),
  errorGeneric: t('deleteAccount.errorGeneric'),
  errorRateLimited: t('deleteAccount.errorRateLimited'),
  errorInvalidCode: t('deleteAccount.errorInvalidCode'),
};
---

<section class="pt-40 pb-24 px-6">
  <div class="max-w-md mx-auto">
    <h1 class="text-3xl font-bold mb-4 text-center">{t('deleteAccount.title')}</h1>
    <div class="section-divider mb-8"></div>
    <p class="text-text-muted text-sm leading-relaxed mb-8 text-center">{t('deleteAccount.intro')}</p>

    <!--
      Every failure this flow can hit — wrong code, rate limit, network — is
      reported only here, and until this carried a role a screen-reader user
      submitted the form and got silence back. `role="alert"` (assertive) is
      right for errors: the message contradicts what the user just tried to do,
      so it should interrupt rather than wait for a pause.

      The element is rendered on every page load, empty, so that the live region
      already exists when a message lands in it; showAlert() below unhides it
      before writing the text, because a `display: none` element is not in the
      accessibility tree and a message written into one can be published with
      nothing listening.
    -->
    <div
      id="da-alert"
      role="alert"
      aria-live="assertive"
      aria-atomic="true"
      class="hidden mb-4 rounded-lg border border-error/30 bg-error/10 px-4 py-3 text-sm text-error"
    ></div>

    <form id="da-email-form" class="space-y-4">
      <div>
        <label for="da-email" class="block text-sm font-medium mb-2">{t('deleteAccount.emailLabel')}</label>
        <input
          id="da-email"
          type="email"
          required
          autocomplete="email"
          placeholder={t('deleteAccount.emailPlaceholder')}
          class="w-full rounded-lg bg-secondary border border-border px-4 py-3 text-sm text-text placeholder:text-text-muted focus:outline-none focus:ring-1 focus:ring-accent"
        />
      </div>
      <button
        type="submit"
        id="da-send-btn"
        class="w-full px-5 py-3 rounded-lg bg-secondary hover:bg-secondary/70 transition-colors text-accent font-medium text-sm disabled:opacity-50 disabled:cursor-not-allowed"
      >
        {t('deleteAccount.sendCodeButton')}
      </button>
    </form>

    <form id="da-code-form" class="hidden space-y-4">
      <p class="text-sm text-text-muted">
        {t('deleteAccount.codeSentIntro')} <strong id="da-target-email" class="text-text"></strong>
      </p>
      <div>
        <label for="da-code" class="block text-sm font-medium mb-2">{t('deleteAccount.codeLabel')}</label>
        <input
          id="da-code"
          type="text"
          inputmode="numeric"
          pattern="[0-9]*"
          maxlength="6"
          required
          autocomplete="one-time-code"
          placeholder="••••••"
          class="w-full rounded-lg bg-secondary border border-border px-4 py-3 text-center text-lg tracking-[0.5em] text-text focus:outline-none focus:ring-1 focus:ring-accent"
        />
      </div>
      <p class="rounded-lg border border-warning/30 bg-warning/10 px-4 py-3 text-xs text-warning leading-relaxed">
        {t('deleteAccount.warning')}
      </p>
      <button
        type="submit"
        id="da-confirm-btn"
        class="w-full px-5 py-3 rounded-lg border border-error text-error hover:bg-error/10 transition-colors font-medium text-sm disabled:opacity-50 disabled:cursor-not-allowed"
      >
        {t('deleteAccount.confirmButton')}
      </button>
      <button
        type="button"
        id="da-back-btn"
        class="w-full text-xs text-text-muted hover:text-text transition-colors"
      >
        {t('deleteAccount.backButton')}
      </button>
    </form>

    <!--
      Confirmation that an account was deleted, which is the one message on this
      site a user must not miss. Its copy is server-rendered, so nothing about it
      changes when it is revealed and a live region alone would announce
      nothing — the script moves focus here after the reveal, and `role="status"`
      (polite) then reads it out without cutting off whatever is being spoken.
      Polite rather than assertive because this is the expected outcome, not an
      interruption. `tabindex="-1"` makes it focusable without adding a tab stop.
    -->
    <div
      id="da-success"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      tabindex="-1"
      class="hidden text-center focus:outline-none"
    >
      <p class="text-lg font-medium mb-2">{t('deleteAccount.successTitle')}</p>
      <p class="text-sm text-text-muted">{t('deleteAccount.successBody')}</p>
    </div>
  </div>
</section>

<!--
  `is:inline` is explicit because it is load-bearing, not incidental: this
  script has to stay inline in the page (define:vars would force that anyway),
  and its body therefore differs on each of the four delete-account pages
  because the translated strings are interpolated into it. That is why the CSP
  hash for it is computed per page, after the build — see
  scripts/apply-csp-hashes.mjs.
-->
<script is:inline define:vars={{ apiBase: API_BASE_URL, i18n }}>
  const emailForm = document.getElementById('da-email-form');
  const codeForm = document.getElementById('da-code-form');
  const successBox = document.getElementById('da-success');
  const alertBox = document.getElementById('da-alert');
  const targetEmailEl = document.getElementById('da-target-email');
  const emailInput = document.getElementById('da-email');
  const codeInput = document.getElementById('da-code');
  const sendBtn = document.getElementById('da-send-btn');
  const confirmBtn = document.getElementById('da-confirm-btn');
  const backBtn = document.getElementById('da-back-btn');

  let currentEmail = '';

  function showAlert(message) {
    // Order matters. The box is unhidden first so the alert region is in the
    // accessibility tree, and the text is written on the next frame so it
    // arrives as a change to a region that is already there — a text node set
    // while the element is still `display: none` is announced unreliably or not
    // at all. Blanking it first also guarantees a change when the same error
    // (a wrong code twice) is shown again.
    alertBox.textContent = '';
    alertBox.classList.remove('hidden');
    requestAnimationFrame(() => {
      alertBox.textContent = message;
    });
  }

  function hideAlert() {
    alertBox.classList.add('hidden');
    // Cleared as well as hidden, so a stale message cannot be re-announced the
    // next time the region is revealed.
    alertBox.textContent = '';
  }

  async function postJson(path, body) {
    try {
      const res = await fetch(apiBase + path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      return { ok: res.ok, status: res.status };
    } catch {
      return { ok: false, status: 0 };
    }
  }

  emailForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();
    const email = emailInput.value.trim();
    if (!email) return;

    const originalLabel = sendBtn.textContent;
    sendBtn.disabled = true;
    sendBtn.textContent = i18n.sending;

    const { ok, status } = await postJson('/account-deletion/request', { email });

    sendBtn.disabled = false;
    sendBtn.textContent = originalLabel;

    if (status === 429) {
      showAlert(i18n.errorRateLimited);
      return;
    }
    if (!ok) {
      showAlert(i18n.errorGeneric);
      return;
    }

    currentEmail = email;
    targetEmailEl.textContent = email;
    emailForm.classList.add('hidden');
    codeForm.classList.remove('hidden');
    codeInput.focus();
  });

  backBtn.addEventListener('click', () => {
    hideAlert();
    codeForm.classList.add('hidden');
    emailForm.classList.remove('hidden');
    codeInput.value = '';
  });

  codeForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();
    const code = codeInput.value.trim();
    if (!code) return;
    if (!window.confirm(i18n.confirmPrompt)) return;

    const originalLabel = confirmBtn.textContent;
    confirmBtn.disabled = true;
    confirmBtn.textContent = i18n.deleting;

    const { ok, status } = await postJson('/account-deletion/confirm', {
      email: currentEmail,
      code,
    });

    confirmBtn.disabled = false;
    confirmBtn.textContent = originalLabel;

    if (status === 429) {
      showAlert(i18n.errorRateLimited);
      return;
    }
    if (!ok) {
      showAlert(i18n.errorInvalidCode);
      return;
    }

    codeForm.classList.add('hidden');
    successBox.classList.remove('hidden');
    // The form the user was in has just gone away; without this, focus is left
    // on a hidden button and the confirmation is never read out.
    successBox.focus();
  });
</script>
