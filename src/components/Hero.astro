---
import { useTranslations, type Lang, defaultLang } from '../i18n/utils';
import {
  PLAY_STORE_URL,
  APP_STORE_URL,
  isLiveStoreUrl,
} from '../site-config';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const playLive = isLiveStoreUrl(PLAY_STORE_URL);
const appLive = isLiveStoreUrl(APP_STORE_URL);
const anyStoreLive = playLive || appLive;

const liveButtonClass =
  'inline-flex items-center gap-3 min-w-[13.5rem] px-5 py-3 rounded-xl bg-secondary border border-border hover:border-accent/50 hover:bg-secondary/80 transition-colors text-left';
const soonButtonClass =
  'inline-flex items-center gap-3 min-w-[13.5rem] px-5 py-3 rounded-xl bg-secondary/40 border border-border/40 text-text-muted cursor-default text-left';
---

<!-- The blurred accent glow that used to sit behind this heading is gone, for
     the same reason the app's ambient background blobs are: it is decoration
     competing with the one line the page exists to deliver. Flat ground. -->
<section class="relative pt-40 pb-28 px-6 text-center">
  <div class="max-w-3xl mx-auto">
    {playLive ? (
      <a
        href={PLAY_STORE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mb-6 px-3 py-1 rounded-full text-xs font-medium tracking-wide uppercase bg-secondary text-accent hover:bg-secondary/80 transition-colors"
      >
        {t('hero.badge')}
      </a>
    ) : (
      <span class="inline-block mb-6 px-3 py-1 rounded-full text-xs font-medium tracking-wide uppercase bg-secondary text-accent">
        {t('hero.badge')}
      </span>
    )}
    <h1 class="text-5xl sm:text-6xl font-bold tracking-tight mb-6 text-text">
      {t('site.title')}
    </h1>
    <p class="text-lg sm:text-xl text-text-muted max-w-xl mx-auto">
      {t('hero.subtitle')}
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center items-center">
      {anyStoreLive ? (
        <>
          {playLive ? (
            <a
              href={PLAY_STORE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class={liveButtonClass}
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-7 h-7 shrink-0" aria-hidden="true">
                <path fill="#34A853" d="M3.6 21.3 13.2 12 3.6 2.7c-.4.2-.6.7-.6 1.3v16c0 .6.2 1.1.6 1.3Z"/>
                <path fill="#FBBC04" d="m16.7 8.5-3.5 3.5 3.5 3.5 3.6-2.1c.8-.4.8-1.2 0-1.7z"/>
                <path fill="#4285F4" d="M3.6 21.3c.3.2.7.3 1.1.1L16.7 15.5 13.2 12z"/>
                <path fill="#EA4335" d="M16.7 8.5 4.7 2.6c-.4-.2-.8-.1-1.1.1L13.2 12z"/>
              </svg>
              <span>
                <span class="block text-[10px] uppercase tracking-wider text-text-muted leading-none mb-1">Google Play</span>
                <span class="block text-sm font-semibold text-text leading-tight">{t('cta.playStore')}</span>
              </span>
            </a>
          ) : (
            <span class={soonButtonClass} title={t('cta.comingSoonHint')}>
              {t('cta.playStoreSoon')}
            </span>
          )}
          {appLive ? (
            <a
              href={APP_STORE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class={liveButtonClass}
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7 shrink-0" aria-hidden="true">
                <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
              </svg>
              <span>
                <span class="block text-[10px] uppercase tracking-wider text-text-muted leading-none mb-1">App Store</span>
                <span class="block text-sm font-semibold text-text leading-tight">{t('cta.appStore')}</span>
              </span>
            </a>
          ) : (
            <span class={soonButtonClass} title={t('cta.comingSoonHint')}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7 shrink-0 opacity-50" aria-hidden="true">
                <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
              </svg>
              <span>
                <span class="block text-[10px] uppercase tracking-wider leading-none mb-1">App Store</span>
                <span class="block text-sm font-medium leading-tight">{t('cta.appStoreSoon')}</span>
              </span>
            </span>
          )}
        </>
      ) : (
        <span
          class="px-5 py-3 rounded-lg bg-secondary/40 text-text-muted font-medium text-sm cursor-default"
          title={t('cta.comingSoonHint')}
        >
          {t('cta.storesComingSoon')}
        </span>
      )}
    </div>
  </div>
</section>
