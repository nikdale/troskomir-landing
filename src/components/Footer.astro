---
import { useTranslations, type Lang, defaultLang } from '../i18n/utils';
import { TELEGRAM_URL } from '../site-config';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer id="kontakt" class="py-12 px-6 border-t border-border text-center">
  <p class="text-text-muted text-sm">
    {t('footer.contact')}{' '}
    <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
      Telegram
    </a>
  </p>
  <p class="text-text-muted text-xs mt-4">&copy; {year} {t('site.title')} — {t('footer.rights')}</p>
</footer>
