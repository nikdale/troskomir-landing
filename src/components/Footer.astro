---
import { useTranslations, type Lang, defaultLang, getLocalizedPath } from '../i18n/utils';
import { TELEGRAM_URL } from '../site-config';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer id="kontakt" class="py-12 px-6 border-t border-secondary text-center">
  <p class="text-text-muted text-sm">
    {t('footer.contact')}{' '}
    <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer" class="text-accent-light hover:underline">
      Telegram
    </a>
  </p>
  <p class="text-text-muted text-xs mt-4">&copy; {year} {t('site.title')} — {t('footer.rights')}</p>
  <p class="text-text-muted text-xs mt-2">
    <a href={getLocalizedPath('delete-account', lang, base)} class="hover:text-text hover:underline transition-colors">
      {t('nav.deleteAccount')}
    </a>
  </p>
</footer>
