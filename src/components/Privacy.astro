---
import { useTranslations, type Lang, defaultLang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<section id="privatnost" class="py-24 px-6">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-3xl font-bold mb-4">{t('privacy.title')}</h2>
    <div class="section-divider mb-8"></div>
    <p class="text-text-muted leading-relaxed">{t('privacy.body')}</p>
  </div>
</section>
