---
import '../styles/global.css';
import { type Lang, defaultLang, getAlternateUrls, useTranslations } from '../i18n/utils';
import { API_BASE_URL } from '../site-config';

interface Props {
  lang?: Lang;
  /**
   * Per-page <title> and <meta name="description">.
   *
   * They default to the site-wide strings, which used to be all any page
   * got: ~24 pages across six routes and four locales shared one title and
   * one description. That is the usual reason a crawler folds a set of pages
   * into one result — and the page it would drop here is the privacy policy
   * Play re-checks on the developer website. Every page passes real values;
   * the defaults exist so a new page renders something sane rather than
   * nothing.
   */
  title?: string;
  description?: string;
}

const { lang = defaultLang, title, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t('site.title');
const pageDescription = description ?? t('site.description');

const htmlLang = lang === 'sr' ? 'sr-Cyrl' : lang;
const ogLocale = lang === 'sr' || lang === 'sr-Latn' ? 'sr_RS' : lang === 'ru' ? 'ru_RU' : 'en_US';

const base = import.meta.env.BASE_URL;
// Only the delete-account form talks to the API; the CSP allows exactly that
// origin and nothing else.
const API_ORIGIN = new URL(API_BASE_URL).origin;
const siteUrl = Astro.site?.toString() || '';
const alternateUrls = getAlternateUrls(Astro.url.pathname, siteUrl, base);

// The canonical is this page's own hreflang alternate, taken from the same
// helper rather than rebuilt from Astro.url: a canonical that spells the URL
// differently from the alternate that points back at it (/about vs /about/)
// is a contradiction, and the four language variants then compete instead of
// consolidating.
const canonical = alternateUrls.find((a) => a.lang === lang)?.url ?? Astro.url.href;

// 1200×630, generated by scripts/build-og-image.mjs. Previously app-icon.png,
// which is square and therefore cropped or shrunk to a thumbnail in every
// link preview.
const ogImage = `${siteUrl}og-image.png`;

// GitHub Pages can't set response headers, so the CSP has to be a meta tag.
// Everything the site needs is same-origin: Inter is self-hosted under /fonts
// (see src/styles/fonts.css), there are no third-party scripts, and the only
// network call any page makes is the delete-account form posting to the API.
// `frame-ancestors` and `report-uri` are ignored in meta form — that's a
// documented limitation, not an omission.
//
// `script-src 'self' 'unsafe-inline'` is a placeholder that survives only into
// `astro dev`. Three components ship inline scripts (About, DeleteAccount,
// /open) whose bodies differ per locale — DeleteAccount interpolates the
// translated strings through `define:vars`, so the same component hashes
// differently on each of its four pages — and none of those hashes can be
// known while this layout is still rendering. `npm run build` is
// `astro build && node scripts/apply-csp-hashes.mjs`; that second step
// rewrites this directive page by page into `'self'` plus the SHA-256 of that
// page's own inline scripts. tests/head-metadata.test.mjs reads the built
// pages and fails if any of them still carries the placeholder, still allows
// inline script, or omits the hash of a script it actually ships.
//
// This lives in the frontmatter rather than as an HTML comment beside the tag
// on purpose: as markup it was served to every visitor on all 21 pages, and
// it also made "does any built page still allow inline script?" ungreppable,
// because the prose said 'unsafe-inline' too.
//
// `style-src` keeps 'unsafe-inline' for real: Tailwind and Astro both emit
// inline style attributes, and hashes do not cover those.
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self' ${API_ORIGIN}`,
  "form-action 'self'",
  "base-uri 'self'",
  "object-src 'none'",
].join('; ');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={t('site.title')} />
    <!-- Without og:url a scraper resolves the shared link itself, which turns
         a tracking-parameter URL or a redirect into a separate preview. -->
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Alternate language links -->
    {alternateUrls.map(({ lang: altLang, url }) => (
      <link rel="alternate" hreflang={altLang === 'sr' ? 'sr-Cyrl' : altLang} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrls.find((a) => a.lang === defaultLang)?.url} />

    <!-- Why this policy is stricter in a built page than it looks in source:
         see this file's frontmatter. -->
    <meta http-equiv="Content-Security-Policy" content={csp} />

    <!-- Inter is self-hosted; preload the weight above the fold. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}fonts/inter-latin-400.woff2`}
      crossorigin
    />

    <link rel="icon" type="image/png" href={`${base}app-icon.png`} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-primary text-text antialiased">
    <slot />
  </body>
</html>
