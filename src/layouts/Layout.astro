---
import '../styles/global.css';
import { type Lang, defaultLang, getAlternateUrls, useTranslations } from '../i18n/utils';
import { API_BASE_URL } from '../site-config';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const title = t('site.title');
const description = t('site.description');

const htmlLang = lang === 'sr' ? 'sr-Cyrl' : lang;
const ogLocale = lang === 'sr' || lang === 'sr-Latn' ? 'sr_RS' : lang === 'ru' ? 'ru_RU' : 'en_US';

const base = import.meta.env.BASE_URL;
// Only the delete-account form talks to the API; the CSP allows exactly that
// origin and nothing else.
const API_ORIGIN = new URL(API_BASE_URL).origin;
const alternateUrls = getAlternateUrls(Astro.url.pathname, Astro.site?.toString() || '', base);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={`${Astro.site?.toString() || ''}app-icon.png`} />

    <!-- Alternate language links -->
    {alternateUrls.map(({ lang: altLang, url }) => (
      <link rel="alternate" hreflang={altLang === 'sr' ? 'sr-Cyrl' : altLang} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrls.find((a) => a.lang === defaultLang)?.url} />

    <!--
      GitHub Pages can't set response headers, so the CSP has to be a meta tag.
      Everything the site needs is same-origin: Inter is self-hosted under
      /fonts (see src/styles/fonts.css), there are no third-party scripts, and
      the only network call any page makes is the delete-account form posting
      to the API. `frame-ancestors` and `report-uri` are ignored in meta form —
      that's a documented limitation, not an omission.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content={[
        "default-src 'self'",
        "script-src 'self' 'unsafe-inline'",
        "style-src 'self' 'unsafe-inline'",
        "img-src 'self' data:",
        "font-src 'self'",
        `connect-src 'self' ${API_ORIGIN}`,
        "form-action 'self'",
        "base-uri 'self'",
        "object-src 'none'",
      ].join('; ')}
    />

    <!-- Inter is self-hosted; preload the weight above the fold. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}fonts/inter-latin-400.woff2`}
      crossorigin
    />

    <link rel="icon" type="image/png" href={`${base}app-icon.png`} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-primary text-text antialiased">
    <slot />
  </body>
</html>
